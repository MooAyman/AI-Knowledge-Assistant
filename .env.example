# Hugging Face token for embeddings (intfloat/multilingual-e5-small)
EMBEDDING_API_KEY=your_huggingface_token_here

# OpenAI key for generation (gpt-4o-mini) and RAGAS evaluation
OPENAI_API_KEY=your_openai_api_key_here

# Langfuse tracing for the advanced pipeline
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Local document paths (use your own HR / policy files)
RAW_DOC_PATH=data/raw/hr_guide.docx
PROCESSED_TEXT_PATH=data/processed/hr_guide.txt
